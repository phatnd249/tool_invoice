# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER COMPOSE - TOOL INVOICE
# -----------------------------------------------------------------------------
# Cách sử dụng:
#   1. Sao chép file này: cp .env.example .env
#   2. Cập nhật các giá trị bí mật (JWT, Admin, Gemini AI) bên dưới
#   3. Khởi chạy hệ thống: docker compose up -d --build
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CỔNG & TÊN MIỀN (NETWORK & APP URL)
# ─────────────────────────────────────────────────────────────────────────────
# Cổng mở ra trên máy chủ (host). Mặc định: 9000
HOST_PORT=9000

# APP_URL: URL công khai của hệ thống (dùng cho CORS).
#   - Chạy test cục bộ:   http://localhost:9000
#   - Chạy trên Server:   https://invoice.yourdomain.com (qua Cloudflare / Nginx)
APP_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────────────────────
# 2. KHÓA BẢO MẬT JWT (BẮT BUỘC TRÊN PRODUCTION - TỐI THIỂU 32 KÝ TỰ)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ CẢNH BÁO: Vì NODE_ENV=production, hệ thống sẽ CRASH NGAY LẬP TỨC nếu
# 2 khóa này ngắn hơn 32 ký tự hoặc chứa từ khóa mặc định như "your-super-secret".
# Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
JWT_ACCESS_SECRET=c4a8b792e46f48d9a26388f8d531ef5a4e321b0e88241d6360c7f938dcb90a42
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=7f8a9e2d1c3b4a5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# 3. KHỞI TẠO TÀI KHOẢN QUẢN TRỊ VIÊN (ADMIN SEED LẦN ĐẦU)
# ─────────────────────────────────────────────────────────────────────────────
# Đặt "true" để tự động tạo tài khoản Super Admin khi khởi động container lần đầu.
# Script seed an toàn (upsert), không xóa dữ liệu cũ.
SEED_ON_START=true
ADMIN_EMAIL=admin@example.com
# Mật khẩu tối thiểu 8 ký tự
ADMIN_INITIAL_PASSWORD=AdminPassword@2026

# ─────────────────────────────────────────────────────────────────────────────
# 4. GEMINI AI (GIẢI CAPTCHA TỔNG CỤC THUẾ)
# ─────────────────────────────────────────────────────────────────────────────
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# 5. GDT & GOTENBERG (HÓA ĐƠN ĐIỆN TỬ & PDF)
# ─────────────────────────────────────────────────────────────────────────────
GDT_BASE_URL=https://hoadondientu.gdt.gov.vn/api

# ─────────────────────────────────────────────────────────────────────────────
# 6. EMAIL CẢNH BÁO & XÁC THỰC (SMTP - TÙY CHỌN)
# ─────────────────────────────────────────────────────────────────────────────
# Để trống nếu chưa cấu hình (hệ thống sẽ log ra console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# 7. GOOGLE DRIVE BACKUP (TÙY CHỌN - TỰ ĐỘNG SAO LƯU DỮ LIỆU)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
BACKUP_AUTO_ENABLED=true
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_COUNT=7
BACKUP_MODE=INCREMENTAL
BACKUP_MAX_CHUNK_SIZE_MB=15
BACKUP_CHUNK_DELAY_MS=2000
