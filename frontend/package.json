{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build-main": "tsc electron/main.ts electron/preload.ts --outDir dist-electron --module commonjs --target es2021 --moduleResolution node --skipLibCheck --ignoreConfig --ignoreDeprecations 6.0 && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron:build-main && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "npm run build && npm run electron:build-main && electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "html2pdf.js": "^0.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/electron-is-dev": "^0.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axios": "^1.18.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.invoicepro.app",
    "productName": "Invoice Downloader Pro",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "@prisma/**/*",
          ".prisma/**/*",
          "sharp/**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "prisma/**/*",
          "package.json",
          "!prisma/dev.db-journal"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    }
  }
}
