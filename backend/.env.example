# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
# APP_URL = origin công khai của app, dùng cho CORS (Origin header).
# BẮT BUỘC đổi theo nơi triển khai, ví dụ:
#   - Production (Docker + reverse proxy): https://invoice.example.com
#   - Kiểm thử local qua cổng 9000:       http://localhost:9000
# Nếu sai, trình duyệt sẽ chặn request do CORS mismatch.
APP_URL="http://localhost:5173"
PORT=3000

# Gemini AI (dùng để giải captcha khi đăng nhập GDT)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# Models hợp lệ (Stable): gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"

# Mail (SMTP Gmail dùng để gửi email xác thực, reset mật khẩu, feedback)
# Để trống nếu chưa cấu hình - hệ thống sẽ log email ra console thay vì gửi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO_EMAIL=

# GDT (Tổng cục Thuế)
GDT_BASE_URL=https://hoadondientu.gdt.gov.vn/api

# Thư mục lưu file hoá đơn (ZIP, XML, PDF)
# Đường dẫn tương đối hoặc tuyệt đối. Mặc định: ./invoices
INVOICES_DIR=./invoices

# Service convert HTML to PDF
GOTENBERG_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive Backup Configuration (Google OAuth 2.0)
# ─────────────────────────────────────────────────────────────────────────────
# Phương án kết nối: Google OAuth 2.0 (Đăng nhập trực tiếp trên web UI)
# 1. Truy cập https://console.cloud.google.com/apis/credentials
# 2. Bật Google Drive API
# 3. Tạo OAuth 2.0 Client ID (loại Web Application)
# 4. Thêm Authorized redirect URI: http://localhost:5173/backup
# 5. Điền thông tin Client ID và Client Secret vào dưới đây (hoặc nhập trực tiếp trên web UI /backup)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/backup
GOOGLE_DRIVE_FOLDER_ID=

# Khóa bí mật dùng để mã hóa AES-256-GCM các token/thông tin nhạy cảm trong database
# (Nếu để trống sẽ tự động fallback sang JWT_ACCESS_SECRET)
BACKUP_ENCRYPTION_KEY=

# Bật/tắt tự động backup theo lịch
BACKUP_AUTO_ENABLED=true

# Lịch chạy backup (định dạng Cron) - Mặc định: "0 2 * * *" = 02:00 sáng mỗi ngày
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Số bản backup tối đa giữ lại trên Google Drive (0 = giữ tất cả)
BACKUP_RETENTION_COUNT=7

# Chế độ sao lưu hóa đơn (INCREMENTAL: chỉ sao lưu mới/sửa đổi | FULL: sao lưu toàn bộ)
BACKUP_MODE=INCREMENTAL

# Dung lượng tối đa mỗi file nhỏ (MB) và thời gian nghỉ giãn cách giữa các lần tải (ms)
BACKUP_MAX_CHUNK_SIZE_MB=15
BACKUP_CHUNK_DELAY_MS=2000


# ─────────────────────────────────────────────────────────────────────────────
# Seed tài khoản quản trị khi khởi động (docker-entrypoint.sh)
# ─────────────────────────────────────────────────────────────────────────────

# "true" để chạy seed ở mỗi lần khởi động container (mặc định: false)
# Seed idempotent: đã có dữ liệu thì chỉ bổ sung, KHÔNG xoá.
SEED_ON_START=false

# Chỉ tạo tài khoản admin khi CẢ HAI biến này được đặt.
# Mật khẩu tối thiểu 8 ký tự và sẽ được hash (bcrypt) trước khi lưu.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

