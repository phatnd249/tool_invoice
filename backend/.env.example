# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:5173"
PORT=3000

# Gemini AI (dùng để giải captcha khi đăng nhập GDT)
GEMINI_API_KEY=

# Mail (SMTP Gmail dùng để gửi email xác thực, reset mật khẩu, feedback)
# Để trống nếu chưa cấu hình - hệ thống sẽ log email ra console thay vì gửi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO_EMAIL=

# GDT (Tổng cục Thuế)
GDT_BASE_URL=https://hoadondientu.gdt.gov.vn/api

# Thư mục lưu file hoá đơn (ZIP, XML, PDF)
# Đường dẫn tương đối hoặc tuyệt đối. Mặc định: ./invoices
INVOICES_DIR=./invoices

# Service convert HTML to PDF
GOTENBERG_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive Backup
# ─────────────────────────────────────────────────────────────────────────────
# ID thư mục trên Google Drive dùng để chứa các bản sao lưu (bắt buộc để sao lưu)
# Lấy từ URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Xác thực bằng Google Service Account (chọn 1 trong 3 cách):
# Cách 1: Đường dẫn file JSON key (khuyên dùng cho dev / local)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# Cách 2: Nội dung JSON key dạng chuỗi (khuyên dùng cho Docker / CI-CD / Cloud)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Cách 3: Client Email + Private Key trực tiếp
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Tự động sao lưu định kỳ (true / false, mặc định: true khi đã cấu hình Drive)
BACKUP_AUTO_ENABLED=true

# Biểu thức Cron cho lịch sao lưu tự động (mặc định: 02:00 sáng mỗi ngày)
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Số bản sao lưu tối đa giữ lại trên Google Drive (0 = giữ lại tất cả, không tự xoá)
BACKUP_RETENTION_COUNT=0

