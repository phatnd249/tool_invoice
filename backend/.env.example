# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:5173"
PORT=3000

# Gemini AI (dùng để giải captcha khi đăng nhập GDT)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# Models hợp lệ (Stable): gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"

# Mail (SMTP Gmail dùng để gửi email xác thực, reset mật khẩu, feedback)
# Để trống nếu chưa cấu hình - hệ thống sẽ log email ra console thay vì gửi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO_EMAIL=

# GDT (Tổng cục Thuế)
GDT_BASE_URL=https://hoadondientu.gdt.gov.vn/api

# Thư mục lưu file hoá đơn (ZIP, XML, PDF)
# Đường dẫn tương đối hoặc tuyệt đối. Mặc định: ./invoices
INVOICES_DIR=./invoices

# Service convert HTML to PDF
GOTENBERG_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Google Drive Backup Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Bước 1: Lấy Folder ID từ Google Drive
# Mở thư mục trên Google Drive, copy ID từ URL:
# https://drive.google.com/drive/folders/<FOLDER_ID_Ở_ĐÂY>
GOOGLE_DRIVE_FOLDER_ID=

# Bước 2: Lấy Service Account JSON credentials
# 1. Truy cập: https://console.cloud.google.com/
# 2. Chọn project hoặc tạo project mới
# 3. Vào: IAM & Admin → Service Accounts
# 4. Create Service Account (đặt tên bất kỳ, ví dụ: "backup-service")
# 5. Click vào service account vừa tạo → Keys → Add Key → Create new key → JSON
# 6. Download file JSON, mở và copy TOÀN BỘ nội dung
# 7. Paste vào đây (có thể để trên 1 dòng hoặc nhiều dòng)
#
# Ví dụ (trên 1 dòng):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-project",...}
#
GOOGLE_SERVICE_ACCOUNT_JSON=

# Bước 3: Share thư mục Google Drive
# QUAN TRỌNG: Vào thư mục Google Drive (bước 1) → Share → 
# Thêm email service account (có trong file JSON, field "client_email")
# Cấp quyền "Editor" (Người chỉnh sửa)
# Nếu không share, backup sẽ lỗi 403 Forbidden!

# ─────────────────────────────────────────────────────────────────────────────
# Backup Settings (Tùy chỉnh tự động backup)
# ─────────────────────────────────────────────────────────────────────────────

# Bật/tắt tự động backup theo lịch
BACKUP_AUTO_ENABLED=true

# Lịch chạy backup (định dạng Cron)
# Mặc định: "0 2 * * *" = 02:00 sáng mỗi ngày
# Ví dụ khác:
#   - "0 */6 * * *" = Mỗi 6 giờ
#   - "0 0 * * 0" = Chủ nhật hàng tuần lúc 00:00
#   - "0 3 1 * *" = Ngày 1 mỗi tháng lúc 03:00
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Số bản backup tối đa giữ lại trên Google Drive
# 0 = giữ tất cả, không tự động xóa
# 7 = chỉ giữ 7 bản mới nhất (bản cũ hơn sẽ tự động xóa)
BACKUP_RETENTION_COUNT=7
