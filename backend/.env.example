# =============================================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and adjust values for your local environment.
# =============================================================================

# Port for the backend API server
PORT=3000

# Database connection URL (SQLite)
# Relative path resolves from the backend/ directory
DATABASE_URL="file:./dev.db"

# --- Optional overrides ---

# Directory to store downloaded invoice files.
# Defaults to the "invoices" folder next to the database file.
# INVOICES_DIR="./invoices"

# Google Gemini API key (for OCR captcha recognition)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# --- Rate limiting for invoice downloads (avoid HTTP 429 from GDT) ---
# DOWNLOAD_DELAY_MS=1500         # Delay between each invoice download (ms)
# DOWNLOAD_BATCH_SIZE=5          # Invoices per batch before extra pause
# DOWNLOAD_BATCH_DELAY_MS=10000  # Extra delay between batches (ms)
# DOWNLOAD_MAX_RETRIES=3         # Max retry attempts on 429/500 errors
