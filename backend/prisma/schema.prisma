// This is your Prisma schema file,
// learn more it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  password         String
  role             String            @default("STAFF") // "ADMIN" or "STAFF"
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  companies        UserCompany[]
  downloadHistories DownloadHistory[]
  feedbacks        Feedback[]
}

model Company {
  id             Int           @id @default(autoincrement())
  taxCode        String        @unique
  name           String
  lookupPassword String
  token          String?
  tokenExpiredAt DateTime?
  loginMode      String        @default("AUTO") // "AUTO" or "MANUAL"
  downloadCount  Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  schedules      Schedule[]
  users          UserCompany[]
}

model UserCompany {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String
  invoiceDate        DateTime
  templateSymbol     String        // Ký hiệu mẫu hóa đơn (khmshdon)
  invoiceSymbol      String        // Ký hiệu hóa đơn (khhdon)
  paymentMethod      String?       // Hình thức thanh toán (htttoan)
  currency           String        @default("VND") // Đơn vị tiền tệ (dvtte)
  exchangeRate       Float         @default(1.0) // Tỷ giá (tgia)
  taxAuthorityCode   String?       // Mã cơ quan thuế (mccqt)
  lookupCode         String?       // Mã tra cứu (matracuu)
  invoiceName        String?       // Tên hóa đơn (thdon)
  version            String?       // Phiên bản (pban)
  gdtProviderTaxCode String?       // Mã số thuế tổ chức giải pháp (msttcgp)

  // Seller info
  sellerName         String
  sellerTaxCode      String
  sellerAddress      String?
  sellerPhone        String?

  // Buyer info
  buyerName          String
  buyerTaxCode       String
  buyerAddress       String?
  buyerCustomerId    String?

  // Financial summary
  totalBeforeTax     Float
  taxAmount          Float
  totalAmount        Float
  totalAmountInWords String?

  type               String        // "BUY" (Mua vào) or "SELL" (Bán ra)
  pdfPath            String?
  xmlPath            String?
  zipPath            String?       // Đường dẫn file ZIP gốc đã tải
  isSavedToDb        Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              InvoiceItem[]

  @@unique([invoiceNumber, sellerTaxCode, buyerTaxCode])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber  String? // Số thứ tự dòng (stt)
  name        String  // Tên hàng hóa, dịch vụ (thhdvu)
  unit        String? // Đơn vị tính (dvtinh)
  quantity    Float?  // Số lượng (sluong)
  price       Float?  // Đơn giá (dgia)
  amount      Float   // Thành tiền chưa thuế (thtien)
  taxRate     String? // Thuế suất (tsuat)
}

model DownloadHistory {
  id              Int      @id @default(autoincrement())
  downloadDate    DateTime @default(now())
  taxCode         String
  invoiceType     String   // "BUY" or "SELL" or "BOTH"
  status          String   // "SUCCESS" or "FAILED" or "PARTIAL"
  log             String?
  countDownloaded Int      @default(0)
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username        String?
}

model Schedule {
  id             Int       @id @default(autoincrement())
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cronExpression String    // e.g., "0 9 * * *" (9 AM daily)
  invoiceType    String    // "BUY" or "SELL"
  isActive       Boolean   @default(true)
  lastRun        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Setting {
  key   String @id
  value String
}

model Feedback {
  id        Int      @id @default(autoincrement())
  content   String
  status    String   @default("PENDING") // "PENDING", "RESOLVED", "REJECTED"
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
