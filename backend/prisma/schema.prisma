generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String    @id @default(cuid())
  fullName            String
  email               String    @unique
  password            String
  avatar              String?
  status              String    @default("INACTIVE")
  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?   @unique
  emailVerifyExpiry   DateTime?
  resetPasswordToken  String?   @unique
  resetPasswordExpiry DateTime?
  loginAttempts       Int       @default(0)
  lockUntil           DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  userRoles      UserRole[]
  userCompanies  UserCompany[]
  refreshTokens  RefreshToken[]
  tokenBlacklist TokenBlacklist[]
  createdCompanies Company[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  group       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_blacklist")
}

model Company {
  id             String    @id @default(cuid())
  taxCode        String    @unique
  name           String
  lookupPassword String
  token          String?
  tokenExpiredAt DateTime?
  loginMode      String    @default("AUTO")
  downloadCount  Int       @default(0)

  // Thông tin từ masothue.com
  address        String?
  taxAddress     String?
  representative String?
  phone          String?
  activeDate     String?
  managedBy      String?
  companyType    String?
  status         String?
  lastSyncedAt   DateTime?

  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator         User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  invoices        Invoice[]
  downloadTasks   DownloadTask[]
  scheduleCompanies ScheduleCompany[]
  userCompanies   UserCompany[]

  @@map("companies")
}

model Invoice {
  id                 String   @id @default(cuid())

  // ── Core identity (composite unique) ──
  invoiceNumber      String    // shdon
  invoiceDate        DateTime  // tdlap
  templateSymbol     String    // khmshdon
  invoiceSymbol      String    // khhdon

  // ── Seller ──
  sellerTaxCode      String    // nbmst
  sellerName         String    // nbten

  // ── Buyer (nullable: hoá đơn bán lẻ không có MST) ──
  buyerTaxCode       String?   // nmmst
  buyerName          String?   // nmten || nmtnmua

  // ── Financial ──
  totalBeforeTax     Float?    // tgtcthue
  taxAmount          Float?    // tgtthue
  totalAmount        Float     // tgtttbso
  totalAmountInWords String?   // tgtttbchu

  // ── GDT Status ──
  invoiceStatus      Int?      // tthai: 1=mới, 2=thay thế, 3=điều chỉnh, 4=bị thay thế, 5=bị điều chỉnh, 6=đã huỷ
  processStatus      Int?      // ttxly: trạng thái xử lý của CQT

  // ── Type & source ──
  type               String    // "BUY" | "SELL"
  source             String?   // "query" | "sco-query"

  // ── ZIP / XML paths ──
  zipPath            String?
  xmlPath            String?
  pdfPath            String?

  // ── Download tracking ──
  downloadStatus     String?   // null | "DOWNLOADED" | "PARSED" | "ERROR"
  errorMessage       String?   // Lỗi khi tải ZIP hoặc parse XML

  // ── Relations ──
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items              InvoiceItem[]

  @@unique([invoiceNumber, invoiceSymbol, templateSymbol, sellerTaxCode, buyerTaxCode])
  @@index([companyId, type, invoiceDate])
  @@index([sellerTaxCode, invoiceDate])
  @@index([buyerTaxCode, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber  Int?
  name        String
  unit        String?
  quantity    Float?
  price       Float?
  amount      Float
  taxRate     String?

  @@map("invoice_items")
}

model DownloadTask {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy         String?
  status            String   @default("PENDING")
  progress          Int      @default(0)
  totalInvoices     Int      @default(0)
  processedInvoices Int      @default(0)
  invoiceType       String   @default("BOTH")
  dateStart         String
  dateEnd           String
  logs              String   @default("[]")
  result            String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, status])
  @@map("download_tasks")
}

model Schedule {
  id             String    @id @default(cuid())
  name           String?
  cronExpression String    @default("")
  repeatMode     String    @default("weekly")
  scheduledAt    DateTime?
  dateRangeDays  Int?
  invoiceType    String    @default("SELL")
  overwriteMode  String    @default("SKIP")
  isActive       Boolean   @default(true)
  lastRun        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companies ScheduleCompany[]

  @@map("schedules")
}

model ScheduleCompany {
  scheduleId String
  companyId  String
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([scheduleId, companyId])
  @@map("schedule_companies")
}

model UserCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}
