{
  "name": "tool-invoice-backend",
  "version": "1.0.0",
  "description": "Backend API for Invoice Downloader and Manager",
  "main": "dist/server.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.js",
    "start": "node dist/server.cjs",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "pkg": "pkg ."
  },
  "bin": "dist/server.cjs",
  "pkg": {
    "assets": [
      "prisma/schema.prisma",
      "prisma/dev.db",
      "../frontend/dist/**/*",
      "node_modules/.prisma/client/*.js",
      "node_modules/.prisma/client/package.json",
      "node_modules/.prisma/client/schema.prisma"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64"
    ],
    "outputPath": "../dist-executable"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.15.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "open": "^11.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "esbuild": "^0.28.1",
    "pkg": "^5.8.1",
    "prisma": "^5.15.0",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5"
  }
}